    "code": "import os\nos.environ[\"MPLCONFIGDIR\"]=\"/tmp/mpl\"\nimport matplotlib\nmatplotlib.use(\"Agg\")\nimport matplotlib.pyplot as plt\nfrom io import BytesIO\nimport math\nf,a=plt.subplots(figsize=(3,2))\nline,=a.plot([1,2,3,4],[10,float(\"nan\"),15,20],marker=\"o\")\na.set_xlabel(\"Observation day\")\na.set_ylabel(\"Reported revenue\")\nprint(list(line.get_xdata()))\nprint([math.isnan(float(v)) for v in line.get_ydata()])\nb=BytesIO()\nf.savefig(b,format=\"png\",dpi=60)\nprint(b.getvalue()[:8]==b\"\\x89PNG\\r\\n\\x1a\\n\")\nplt.close(f)",
