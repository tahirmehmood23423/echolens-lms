# --- core ---
NODE_ENV=production
JWT_SECRET=change-this-to-a-long-random-string
APP_URL=https://your-app.onrender.com
DB_PATH=/data/echolens.json
UPLOAD_DIR=/data/uploads

# --- Postgres (optional) ---
# Leave unset and the app keeps using DB_PATH (the JSON file) exactly as
# before - nothing else changes. Set it to move persistence to Postgres:
# see the "Postgres data layer" section at the top of README.md for the
# one-time `npm run migrate` / `npm run migrate:import` steps.
DATABASE_URL=
# Only set this to disable TLS for a local/dev database with no TLS
# support. Do not set it for Render's managed Postgres or any hosted
# Postgres that requires TLS - leave it unset there.
# PGSSLMODE=disable

# --- Talent Marketplace: recruiter signup (optional) ---
# Comma-separated free-mail domains recruiter signup rejects (with an
# override option in the form for small companies without one). Leave
# unset to use the built-in default list (gmail, yahoo, hotmail, outlook,
# live, protonmail/proton.me).
# RECRUITER_BLOCKED_EMAIL_DOMAINS=gmail.com,yahoo.com,hotmail.com,outlook.com,live.com,protonmail.com,proton.me

# --- AI copilot (optional; teachers only) ---
# Default provider is Groq (model llama-3.3-70b-versatile). Free key: https://console.groq.com
# Groq is the default because Gemini's free-tier quotas have been unreliable in production.
GROQ_API_KEY=
# Set BOTH keys and the app falls back automatically when one runs out of quota.
GEMINI_API_KEY=
# AI_PROVIDER=gemini
# AI_MODEL=
# Served answers per user per hour. Failed calls are refunded, so a provider
# outage no longer eats a learner's allowance.
# AI_HOURLY_LIMIT=30
# How long a provider that answered "quota exhausted" is skipped in favour of
# the other key before being tried again.
# AI_COOLDOWN_MINUTES=15

# --- free-course pacing ---
# Hours before an enrolment is confirmed and the course opens. Until then the
# seat is held but no lesson content is served and no submission is accepted.
# ENROLLMENT_HOLD_HOURS=1
# The window a learner is promised their grades within, and the span the
# grading worker keeps retrying across. NOT a delay - a grade shows the moment
# it is awarded, and the next module opens with it.
# GRADING_WINDOW_HOURS=8
# Free courses a learner may study at once.
# MAX_ACTIVE_FREE_COURSES=2

# --- Google sign-in for the free tier (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- transactional email (SMTP mailbox) ---
# Powers ONLY system mail the recipient is expecting right now: credentials,
# password-reset codes, certificate-ready notices, grading/reminder pings,
# a single batch's announcement. This is a normal mailbox - it must never be
# used for outreach (see "bulk email" below). MAIL_FROM's address must be the
# SMTP_USER mailbox or an approved alias (Zoho/Gmail reject mismatched From
# addresses, and the failure is silent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EchoLens <info@echolens.digital>
# Inter-message pacing on the mailbox path.
SMTP_RATE_LIMIT=3
SMTP_RATE_DELTA_MS=1000
# Hard cap: the app refuses to send more than this many messages through the
# mailbox in one run (one notify()/announcement call). A wider send is a bug
# or belongs on the bulk path.
TRANSACTIONAL_MAX_PER_RUN=20
# Where store.js sends its own Postgres-flush-failure alert. Defaults to
# SMTP_USER if unset.
MAIL_ALERT_TO=

# --- bulk email (outreach: the admin email-blast, site-wide announcements) ---
# Goes through an ESP's HTTP API, NEVER the SMTP mailbox above. Zoho flagged
# a ~379-recipient blast through the mailbox as abuse and blocked sending;
# outreach must stay off that path permanently.
#
# DRY RUN by default: with MAIL_DRY_RUN unset or anything other than "false",
# a blast logs its intended recipients and counts and sends NOTHING. Set it
# to exactly "false" (after the ESP is set up and warmed) to actually send.
MAIL_DRY_RUN=true
# Which ESP. Only "brevo" is implemented today; the interface is swappable.
BULK_MAIL_PROVIDER=brevo
# Brevo REST API key (Brevo dashboard > SMTP & API > API Keys). Free tier is
# ~300 emails/day. See RUNBOOK.md for account + DNS (SPF/DKIM/DMARC) setup.
BREVO_API_KEY=
# From: header for bulk mail. Falls back to MAIL_FROM. The address's domain
# must be authenticated in Brevo (Senders & Domains) or delivery will fail.
BULK_MAIL_FROM=EchoLens <hello@echolens.digital>
# Optional explicit overrides if BULK_MAIL_FROM isn't a "Name <addr>" string.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
# Blast pacing and the circuit breaker.
MAIL_BATCH_SIZE=25
MAIL_BATCH_PAUSE_MS=60000
# Abort the ENTIRE blast after this many consecutive send failures (any
# permanent 5.x.x / abuse rejection aborts immediately regardless).
MAIL_MAX_CONSECUTIVE_FAILURES=3

# --- Showcase Feed: Cloudflare R2 image storage (optional) ---
# Leave unset and post creation is disabled (the feed itself still reads/
# renders fine with zero posts) - these are only needed to accept uploads.
# R2 is S3-compatible; no separate Cloudflare SDK is used. Create a bucket
# in the Cloudflare dashboard, then an API token scoped to it (R2 > Manage
# API Tokens) for the access key pair below.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL images are served from - either R2's own r2.dev subdomain
# for the bucket, or a custom domain mapped to it. Postgres only ever stores
# the R2 key (e.g. showcase/42/ab12.webp); this is prefixed onto it at
# render time to build the actual <img src>, never persisted alongside it.
R2_PUBLIC_BASE_URL=
# Gems awarded once per quest per user for publishing a showcase post tied
# to that quest submission. Never awarded for likes/comments - see
# SHOWCASE_FEED.md.
SHOWCASE_PUBLISH_GEMS=25

# --- live classes: JaaS (8x8.vc) video, optional ---
# Without these, live classes fall back to the free, unauthenticated
# meet.jit.si server (works, but capped at ~5 minutes on some rooms).
# Get these from the 8x8 JaaS console (jaas.8x8.vc) - API Keys page.
JAAS_APP_ID=
JAAS_KID=
# Paste the full PEM, quoted; \n escapes are also accepted for hosts whose
# env var UI won't take real newlines.
JAAS_PRIVATE_KEY=
