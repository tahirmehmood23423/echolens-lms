# --- core ---
NODE_ENV=production
JWT_SECRET=change-this-to-a-long-random-string
APP_URL=https://your-app.onrender.com
DB_PATH=/data/echolens.json
UPLOAD_DIR=/data/uploads

# --- AI copilot (optional; teachers only) ---
# Default provider is Gemini. Get a free key at https://aistudio.google.com
GEMINI_API_KEY=
# or use Groq instead:
# AI_PROVIDER=groq
# GROQ_API_KEY=
# AI_MODEL=gemini-2.0-flash
# AI_HOURLY_LIMIT=30

# --- Google sign-in for the free tier (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- email (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EchoLens <no-reply@echolens.digital>
