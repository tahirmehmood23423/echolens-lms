  judgedBy    Int?      @map("judged_by")
  judgedAt    DateTime? @map("judged_at")
  submittedAt DateTime  @map("submitted_at")

  hackathon Hackathon      @relation(fields: [hackathonId], references: [id])
  entry     HackathonEntry @relation(fields: [entryId], references: [id])

  @@map("hackathon_submissions")
}

// Writer: Quizzes.create/open/close (store.js:1752-1773).
model Quiz {
  id          Int       @id @default(autoincrement())
  batchId     Int       @map("batch_id")
  title       String
  questions   Json // [{q, options[], answer}]
  durationMin Int       @map("duration_min")
  points      Int
  allowIde    Boolean   @default(false) @map("allow_ide")
  openedAt    DateTime? @map("opened_at")
  closesAt    DateTime? @map("closes_at")
  createdBy   Int       @map("created_by")
  createdAt   DateTime  @map("created_at")

  batch    Batch         @relation(fields: [batchId], references: [id])
  attempts QuizAttempt[]

  @@map("quizzes")
}

// Writer: Quizzes.attempt (store.js:1779-1795). Field is `score_pct`, not
// `score`; there is no separate startedAt — only `taken_at`.
model QuizAttempt {
  id       Int      @id @default(autoincrement())
  quizId   Int      @map("quiz_id")
  userId   Int      @map("user_id")
  answers  Json // Int[]
  correct  Int
  total    Int
  scorePct Int      @map("score_pct")
  gems     Int
  takenAt  DateTime @map("taken_at")

  quiz Quiz @relation(fields: [quizId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@map("quiz_attempts")
}

// Writer: TaskFiles.add (store.js:1948-1951). questId is always required
// (Number(quest_id)), contradicting the original nullable guess; `pid` was
// entirely missing from the original draft.
model TaskFile {
  id        Int      @id @default(autoincrement())
  questId   Int      @map("quest_id")
  pid       Int
  name      String
  url       String
  size      Int      @default(0)
  by        Int
  createdAt DateTime @map("created_at")

  quest Quest @relation(fields: [questId], references: [id])

  @@map("task_files")
}

// ─────────────────────────────────────────────────────────────────
// SHOWCASE FEED
// ─────────────────────────────────────────────────────────────────

model ShowcasePost {
  id                Int       @id @default(autoincrement())
  authorUserId      Int       @map("author_user_id")
  caption           String // max 2000 chars, enforced server-side
  questSubmissionId Int?      @map("quest_submission_id")
  courseId          Int?      @map("course_id")
  batchId           Int?      @map("batch_id")
  visibility        String    @default("BATCH") // BATCH|PUBLIC
  status            String    @default("PENDING_REVIEW") // PENDING_REVIEW|PUBLISHED|REMOVED
  likeCount         Int       @default(0) @map("like_count")
  commentCount      Int       @default(0) @map("comment_count")
  createdAt         DateTime  @map("created_at")
  updatedAt         DateTime  @map("updated_at")
  removedAt         DateTime? @map("removed_at")
  removedByUserId   Int?      @map("removed_by_user_id")
  removalReason     String?   @map("removal_reason")

  author          User              @relation("ShowcasePostAuthor", fields: [authorUserId], references: [id])
  questSubmission QuestSubmission?  @relation(fields: [questSubmissionId], references: [id])
  course          Course?           @relation(fields: [courseId], references: [id])
  batch           Batch?            @relation(fields: [batchId], references: [id])
  images          ShowcaseImage[]
  likes           ShowcaseLike[]
  comments        ShowcaseComment[]

  @@index([status, createdAt(sort: Desc)])
  @@index([authorUserId])
  @@map("showcase_posts")
}

// Cascade delete is a deliberate exception to this schema's usual
// RESTRICT/SET NULL convention (see ShowcasePost) - images have no
// standalone meaning once their post is gone.
model ShowcaseImage {
  id        Int    @id @default(autoincrement())
  postId    Int    @map("post_id")
  r2Key     String @map("r2_key")
  thumbKey  String @map("thumb_key")
  width     Int
  height    Int
  byteSize  Int    @map("byte_size")
  sortOrder Int    @map("sort_order")

  post ShowcasePost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("showcase_images")
}

model ShowcaseLike {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  userId    Int      @map("user_id")
  createdAt DateTime @map("created_at")

  post ShowcasePost @relation(fields: [postId], references: [id])
  user User         @relation(fields: [userId], references: [id])

  // Per user row, not per person - see the multi-role email note on User.email.
  // Accepted as noise: a person holding two role-rows could like the same
  // post twice. Not worth new person-identity infrastructure for a cosmetic
  // like-count edge case.
  @@unique([postId, userId])
  @@map("showcase_likes")
}

model ShowcaseComment {
  id              Int       @id @default(autoincrement())
  postId          Int       @map("post_id")
  authorUserId    Int       @map("author_user_id")
  body            String // max 1000 chars, enforced server-side
  status          String    @default("PUBLISHED") // PUBLISHED|REMOVED
  createdAt       DateTime  @map("created_at")
  removedAt       DateTime? @map("removed_at")
  removedByUserId Int?      @map("removed_by_user_id")

  post   ShowcasePost @relation(fields: [postId], references: [id])
  author User         @relation("ShowcaseCommentAuthor", fields: [authorUserId], references: [id])

  @@index([postId, createdAt])
  @@map("showcase_comments")
}

model ShowcaseReport {
  id               Int       @id @default(autoincrement())
  targetType       String    @map("target_type") // POST|COMMENT
  targetId         Int       @map("target_id")
  reporterUserId   Int       @map("reporter_user_id")
  reason           String
  status           String    @default("OPEN") // OPEN|ACTIONED|DISMISSED
  resolvedByUserId Int?      @map("resolved_by_user_id")
  resolvedAt       DateTime? @map("resolved_at")
  createdAt        DateTime  @map("created_at")

  reporter User @relation(fields: [reporterUserId], references: [id])

  @@unique([targetType, targetId, reporterUserId])
  @@map("showcase_reports")
}
