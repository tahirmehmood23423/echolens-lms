# Copy this file to ".env" and fill in real values before going live.

# Port the server listens on (most hosts set this automatically)
PORT=3000

# Set to "production" when deployed (enables secure cookies over HTTPS)
NODE_ENV=development

# Public URL of the app, used in email links
APP_URL=http://localhost:3000

# Secret used to sign login tokens. Use a long random string in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# Where the data file is stored.
# On hosts with a persistent disk, point this at that disk, e.g. /data/echolens.json
DB_PATH=./echolens.json

# Where uploaded course material is stored.
# On hosts with a persistent disk, point this at that disk, e.g. /data/uploads
UPLOAD_DIR=./uploads

# ---- Email (announcements + welcome messages) ----
# Leave blank to disable email: the app still works and just logs what it would send.
# For Gmail, create an App Password (Google Account > Security > App passwords)
# and use it as SMTP_PASS. Do not use your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=echolens816@gmail.com
SMTP_PASS=your-16-character-app-password
MAIL_FROM=EchoLens <echolens816@gmail.com>
