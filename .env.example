# --- core ---
NODE_ENV=production
JWT_SECRET=change-this-to-a-long-random-string
APP_URL=https://your-app.onrender.com
DB_PATH=/data/echolens.json
UPLOAD_DIR=/data/uploads

# --- AI copilot (optional; teachers only) ---
# Default provider is Gemini (model gemini-2.5-flash-lite). Free key: https://aistudio.google.com
GEMINI_API_KEY=
# Set BOTH keys and the app falls back automatically when one runs out of quota.
GROQ_API_KEY=
# AI_PROVIDER=groq
# AI_MODEL=
# AI_HOURLY_LIMIT=30

# --- Google sign-in for the free tier (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- email (optional; powers credentials, submission, grading, reminder & announcement mails) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EchoLens <no-reply@echolens.digital>

# --- live classes: JaaS (8x8.vc) video, optional ---
# Without these, live classes fall back to the free, unauthenticated
# meet.jit.si server (works, but capped at ~5 minutes on some rooms).
# Get these from the 8x8 JaaS console (jaas.8x8.vc) - API Keys page.
JAAS_APP_ID=
JAAS_KID=
# Paste the full PEM, quoted; \n escapes are also accepted for hosts whose
# env var UI won't take real newlines.
JAAS_PRIVATE_KEY=
