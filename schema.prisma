// EchoLens LMS — Postgres schema (VERIFIED against app code, 2026-07-23)
//
// STATUS (updated 2026-07-23): this normalized schema is now migrated into a
// real Supabase Postgres database via DATABASE_URL/DIRECT_URL and is intended
// to become the app's actual persistence going forward. IMPORTANT: store.js
// has NOT been rewritten yet — it still only knows how to read/write the old
// JSONB-blob shape (`(id BIGINT, data JSONB)` per collection, see
// migrations/0001_legacy_store_schema.sql + migrations/import-json.js) via
// db.js/store.js's "Postgres persistence" block, and does not use Prisma at
// all. Do NOT run `migrations/run.js` (the legacy JSONB migration) or
// `migrations/import-json.js` against this same DATABASE_URL — they would
// create/expect a `(id, data)` shape that collides with the relational
// tables Prisma now manages here under the same table names. The app will
// not function against this database until store.js's persistence layer is
// rewritten to query these normalized tables directly instead of JSON blobs.
//
// VERIFICATION METHOD: every model below was checked against the real
// creation/mutation code in store.js and server.js (grep + line-level
// reading), not just the field names a data backup happened to show. Where a
// field's actual JS shape differs from what the original inferred-from-data
// draft assumed, it's corrected here with a comment citing the evidence.
// Models the original draft marked UNVERIFIED (zero rows in that team's
// backup) are rebuilt from their real writer code below, or flagged
// CONFIRMED DEAD when no writer exists anywhere in the repo.
//
// NOTE ON THE SOURCE BACKUP: the schema this file supersedes claimed to be
// derived from `echolens-full-backup-2026-07-21.json` (78 users, 53
// collections, incl. 8 users and 1 batch deleted-but-referenced). That exact
// file is not present anywhere in this environment/repo — every JSON file
// here (root echolens.json, echolens-lms/echolens.json, backups/*.json) has
// only 4 seed users and batch 1 intact, none deleted. The tombstone strategy
// in migrations/import-normalized.js is therefore written to DISCOVER
// dangling foreign-key references dynamically (scan every relation field,
// tombstone whatever's actually missing) rather than hardcode specific ids —
// it will correctly produce tombstones for users 5/8/21/25/27/30/31/42 and
// batch 1 when pointed at the real backup, without depending on that exact
// list being right forever.
//
// DATE-TYPE CONVENTION (verified from store.js):
//   now()   -> `new Date().toISOString().replace('T',' ').slice(0,19)`
//              a full UTC timestamp string ("2026-07-21 14:30:00") -> DateTime
//   today() -> `new Date().toISOString().slice(0,10)`
//              a date-only string ("2026-07-21") -> stays String
// Every DateTime field below is backed by now(); every date-only String
// field is backed by today()/a raw date string. Checked individually, not
// assumed — see per-field comments for anything that deviates (Event/Quest
// .deadline, Hackathon.starts_at/ends_at, Event.startsAt/endsAt, etc).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────
// IDENTITY & ACCESS
// ─────────────────────────────────────────────────────────────────

model User {
  id                   Int       @id @default(autoincrement())
  name                 String
  role                 String // admin|instructor|coordinator|student|free|hr|staff|student_coordinator|finance|ambassador|recruiter
  // VERIFIED nullable: findOrCreateGoogle() sets username: null when there's
  // no email (store.js:492). Still unique when present.
  username             String?   @unique
  email                String? // intentionally NOT unique — see header note in original doc
  regNo                String?   @unique @map("reg_no")
  // VERIFIED nullable: Google-sign-in-only accounts get password_hash: null
  // (store.js:493; checked at server.js login flow).
  passwordHash         String?   @map("password_hash")
  profile              Json      @default("{}")
  streak               Int       @default(0)
  bestStreak           Int       @default(0) @map("best_streak")
  lastActive           DateTime? @map("last_active")
  createdAt            DateTime  @map("created_at")
  onboardingComplete   Boolean   @default(false) @map("onboarding_complete")
  avatar               String?
  // MISSING from original draft: Users.setSignature() writes this (store.js:571).
  signature            String?
  // MISSING from original draft: Google sign-in identity (store.js:480,489,492).
  googleSub            String?   @unique @map("google_sub")
  // Migration-only tombstone flag — NOT read by any current app code. Added
  // solely so import-normalized.js can insert placeholder rows for users
  // referenced by a real FK (e.g. a certificate's user_id) whose original
  // account was deleted, without violating the FK constraint.
  isDeletedPlaceholder Boolean   @default(false) @map("is_deleted_placeholder")

  // --- Talent Marketplace recruiter fields (role='recruiter' only; null otherwise) ---
  // Users.createRecruiter/setRecruiterStatus/resubmitRecruiter (store.js:593-630).
  // Not present in the original draft at all (that backup predates this feature).
  companyId         Int?      @map("company_id")
  designation       String?
  city              String?
  hiringNote        String?   @map("hiring_note")
  status            String? // pending|approved|rejected|needs_info (recruiter verification)
  statusReason      String?   @map("status_reason")
  // Not always present: recruiter-only field (Users.createRecruiter), absent
  // on every non-recruiter row (78/79 real users). No @default(false) - a
  // false default would misrepresent "not a recruiter" as "opted out".
  overrideRequested Boolean?  @map("override_requested")
  overrideReason    String?   @map("override_reason")
  approvedBy        Int?      @map("approved_by")
  approvedAt        DateTime? @map("approved_at")

  company              Company?              @relation(fields: [companyId], references: [id])
  enrollments          Enrollment[]
  questSubmissions     QuestSubmission[]     @relation("SubmissionAuthor")
  gradedSubmissions    QuestSubmission[]     @relation("SubmissionGrader")
  gemEvents            GemEvent[]
  certificates         Certificate[]         @relation("CertificateHolder")
  attendance           Attendance[]
  openSubmissions      OpenSubmission[]
  courseMessages       CourseMessage[]
  eventEntries         EventEntry[]
  eventSubmissions     EventSubmission[]
  eventComments        EventComment[]
  chatReads            ChatRead[]
  aiReports            AiReport[]            @relation("ReportSubject")
  leads                Lead[]
  departmentMembers    DepartmentMember[]    @relation("DeptMember")
  ambassadorProfile    Ambassador?
  staffRecord          StaffRecord?
  legacySubmissions    Submission[]
  challengeSubmissions ChallengeSubmission[]
  quizAttempts         QuizAttempt[]
  jobComments          JobComment[]
  showcasePosts        ShowcasePost[]        @relation("ShowcasePostAuthor")
  showcaseLikes        ShowcaseLike[]
  showcaseComments     ShowcaseComment[]     @relation("ShowcaseCommentAuthor")
  showcaseReports      ShowcaseReport[]

  @@index([role])
  @@map("users")
}

// Registries preventing reuse of retired usernames / reg numbers.
model IssuedUsername {
  value String @id

  @@map("issued_usernames")
}

model IssuedRegno {
  value String @id

  @@map("issued_regnos")
}

model Seq {
  name  String @id
  value Int

  @@map("seq")
}

model Setting {
  key   String @id
  value Json

  @@map("settings")
}

// Talent Marketplace: keyed by normalized work-email domain (store.js:634-654).
// MISSING from the original draft entirely (that backup predates Phase 1).
model Company {
  id        Int      @id @default(autoincrement())
  domain    String   @unique
  name      String
  website   String?
  sizeBand  String?  @map("size_band")
  createdAt DateTime @map("created_at")

  recruiters User[]

  @@map("companies")
}

// Talent Marketplace: generic append-only audit trail (store.js:660-668).
// MISSING from the original draft entirely.
model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?     @map("actor_id")
  action     String
  targetType String   @map("target_type")
  targetId   Int?     @map("target_id")
  detail     Json?
  at         DateTime

  @@map("audit_log")
}

// ─────────────────────────────────────────────────────────────────
// CATALOGUE & COHORTS
// ─────────────────────────────────────────────────────────────────

model Course {
  id        Int      @id @default(autoincrement())
  // VERIFIED nullable: admin create route only enforces `title` — every
  // other field falls back to `|| null` (server.js:660-663).
  code      String?  @unique
  title     String
  tier      String?
  level     String?
  weeks     Int?
  hours     Float?
  pricePkr  Int?     @map("price_pkr")
  summary   String?
  createdAt DateTime @map("created_at")
  badges    Json?
  freeMode  String?  @map("free_mode")

  batches       Batch[]
  lessons       Lesson[]
  showcasePosts ShowcasePost[]

  @@map("courses")
}

model Batch {
  id                   Int      @id @default(autoincrement())
  courseId             Int      @map("course_id")
  code                 String   @unique
  name                 String
  startDate            String   @map("start_date") // date-only
  status               String
  instructorIds        Json     @map("instructor_ids") // Int[]
  createdAt            DateTime @map("created_at")
  // Migration-only tombstone flag (batch 1 in the source backup is deleted
  // but still referenced by 12 quest rows) — not read by any app code.
  isDeletedPlaceholder Boolean  @default(false) @map("is_deleted_placeholder")

  course              Course               @relation(fields: [courseId], references: [id])
  enrollments         Enrollment[]
  quests              Quest[]
  sessions            Session[]
  liveClasses         LiveClass[]
  courseMessages      CourseMessage[]
  chatReads           ChatRead[]
  certificates        Certificate[]
  announcements       Announcement[]
  gemEvents           GemEvent[]
  aiReports           AiReport[]
  lessons             Lesson[]
  assignments         Assignment[]
  quizzes             Quiz[]
  ambassadorGemEvents AmbassadorGemEvent[]
  showcasePosts       ShowcasePost[]

  @@index([courseId])
  @@map("batches")
}

model Enrollment {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  batchId   Int      @map("batch_id")
  createdAt DateTime @map("created_at")

  user  User  @relation(fields: [userId], references: [id])
  batch Batch @relation(fields: [batchId], references: [id])

  @@unique([userId, batchId])
  @@map("enrollments")
}

model Session {
  id          Int       @id @default(autoincrement())
  batchId     Int       @map("batch_id")
  // VERIFIED nullable: server.js:1366 `Number(week_no) || null` / `start_time
  // || null` / `end_time || null`.
  weekNo      Int?      @map("week_no")
  title       String
  sessionDate String    @map("session_date")
  startTime   String?   @map("start_time")
  endTime     String?   @map("end_time")
  room        String
  startedAt   DateTime? @map("started_at")
  endedAt     DateTime? @map("ended_at")
  // VERIFIED nullable: created as null (store.js:874), only set once the
  // session is actually started (store.js:901).
  startedBy   Int?      @map("started_by")
  createdAt   DateTime  @map("created_at")

  batch      Batch        @relation(fields: [batchId], references: [id])
  attendance Attendance[]

  @@map("sessions")
}

// ─────────────────────────────────────────────────────────────────
// QUESTS & SUBMISSIONS
// ─────────────────────────────────────────────────────────────────

model Quest {
  id        Int      @id @default(autoincrement())
  batchId   Int      @map("batch_id") // 12 rows reference deleted batch 1 in the source backup — tombstone required
  trackKey  String   @map("track_key")
  no        Int
  week      Int
  session   Int
  title     String
  topic     String
  // VERIFIED shape is actually {pid, type, title, description, difficulty,
  // points, criteria?, hint?, solution?, refs?} (store.js:1220-1235,
  // tracks/bootcamps.js:51-55) — richer than originally guessed, but since
  // this is stored as Json it's a documentation note, not a schema change.
  // `points` per-problem is genuinely optional: grading code falls back to
  // DEFAULT_ASSIGNMENT_POINTS when absent (store.js:802,1500,1309).
  problems  Json
  createdAt DateTime @map("created_at")
  // VERIFIED date-only, confirmed via deadlineFromStart() (store.js:340-346):
  // `.toISOString().slice(0,10)`, returns null if the batch has no start date.
  deadline  String?

  batch       Batch             @relation(fields: [batchId], references: [id])
  submissions QuestSubmission[]
  taskFiles   TaskFile[]

  @@index([batchId, trackKey])
  @@map("quests")
}

model QuestSubmission {
  id             Int       @id @default(autoincrement())
  questId        Int       @map("quest_id")
  pid            Int
  userId         Int       @map("user_id") // 3 rows reference deleted user 5 in the source backup
  fileUrl        String?   @map("file_url")
  note           String?
  grade          Int?
  gems           Int       @default(0)
  remarks        String?
  submittedAt    DateTime  @map("submitted_at")
  gradedAt       DateTime? @map("graded_at")
  gradedBy       Int?      @map("graded_by") // 13 rows reference deleted user 8 in the source backup
  code           String?
  language       String?
  aiReview       Json?     @map("ai_review")
  reviewShared   Boolean?  @map("review_shared")
  reviewSharedAt DateTime? @map("review_shared_at")
  late           Boolean?
  integrity      Json?
  lateDeduction  Int?      @map("late_deduction")
  telemetry      Json?
  activityReport Json?     @map("activity_report")

  quest         Quest          @relation(fields: [questId], references: [id])
  user          User           @relation("SubmissionAuthor", fields: [userId], references: [id])
  grader        User?          @relation("SubmissionGrader", fields: [gradedBy], references: [id])
  showcasePosts ShowcasePost[]

  @@index([userId])
  @@index([questId, pid])
  @@map("quest_submissions")
}

// Public playground submissions (no enrolment required)
model OpenSubmission {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  trackKey     String    @map("track_key")
  level        Int
  pid          Int
  problemTitle String    @map("problem_title")
  points       Int
  // VERIFIED nullable: a submission can arrive via file_url only
  // (store.js:2897-2901,2909) — code/language are null in that path.
  code         String?
  language     String?
  fileUrl      String?   @map("file_url")
  fileName     String?   @map("file_name")
  submittedAt  DateTime  @map("submitted_at")
  score        Int?
  gems         Int       @default(0)
  feedback     String?
  gradedAt     DateTime? @map("graded_at")
  attempts     Int?
  files        Json?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, trackKey])
  @@map("open_submissions")
}

// ─────────────────────────────────────────────────────────────────
// GEMS
// ─────────────────────────────────────────────────────────────────

model GemEvent {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  batchId       Int?     @map("batch_id")
  amount        Int
  source        String
  // VERIFIED nullable: system-awarded events (streak bonus store.js:681,
  // quiz auto-award store.js:1793) omit `by`; instructor awards pass it.
  note          String?
  by            Int?
  at            DateTime
  // Added 2026-07-27 (Showcase Feed v20): a real dedup key for "award this
  // exactly once" sources, replacing a note-text string match. Both null on
  // every event that isn't such a source (every event before this feature,
  // and every showcase_publish-shaped award attempt that already exists in
  // memory unaffected). Postgres treats NULL as distinct from NULL in a
  // unique index by default, so @@unique below only blocks a real duplicate
  // (same user, same referenceType, same referenceId all non-null) - it
  // does NOT require a partial/filtered index to get "only enforced when
  // all three are non-null" behavior; that's the ordinary multi-column
  // unique-index semantics already, with no extra syntax needed.
  referenceType String?  @map("reference_type")
  referenceId   String?  @map("reference_id")

  user  User   @relation(fields: [userId], references: [id])
  batch Batch? @relation(fields: [batchId], references: [id])

  @@unique([userId, referenceType, referenceId])
  @@index([userId])
  @@map("gem_events")
}

// ─────────────────────────────────────────────────────────────────
// CERTIFICATES
// ─────────────────────────────────────────────────────────────────

model Certificate {
  id             Int      @id @default(autoincrement())
  serial         String   @unique
  userId         Int      @map("user_id") // 1 row references deleted user 5 in the source backup
  studentName    String   @map("student_name")
  regNo          String   @map("reg_no")
  batchId        Int?     @map("batch_id") // confirmed nullable: hackathon/webinar/quest/track/event auto-certs pass batch_id: null (store.js:2573,2952)
  kind           String // course|hackathon|competition|quest|webinar
  title          String
  // NOT always non-null despite the comment below (kept for context: it's
  // accurate for what CURRENT store.js code writes, store.js:1858) - 3 of
  // 32 real certificates hold an explicit null, from before whatever
  // change guarantees the '' fallback today. @default("") never rescues an
  // explicit null (only a missing key), which is what broke the import.
  detail         String?
  completionDate String   @map("completion_date") // VERIFIED date-only, enforced by regex else falls back to today() (store.js:1859)
  instructorName String?  @map("instructor_name")
  instructorSig  String?  @map("instructor_sig")
  issuedBy       Int      @map("issued_by")
  issuedAt       DateTime @map("issued_at")
  // Not always present: missing entirely on 1/32 real certificates.
  concepts       Json?
  finalProject   String?  @map("final_project")
  sourceKind     String?  @map("source_kind")
  // Re-typed Int? (audited against /data/echolens.json 2026-07-26): all 27
  // real non-null values are numeric event ids, none are a track-key slug
  // string - RESOLVED 2026-07-26 (Phase 3 batch 2): confirmed by reading
  // the live code, not just the historical data. OpenQuest.maybeCertify()
  // (store.js:3080) still sets source_id to a String track_key
  // ("bc01-python" etc) whenever a free track's completion auto-certifies
  // - that code path is fully live, it just hasn't fired for any of the
  // 32 certificates imported so far. Split into two fields (below) rather
  // than reverting to String, so the common numeric case stays a real Int.
  sourceId       Int?     @map("source_id")
  // Holds source_id's String form (source_kind = 'track') instead of
  // sourceId; store.js's in-memory shape is untouched - source_id there
  // stays polymorphic Int-or-String exactly as before. Only the Postgres
  // write/read boundary (schema-map.js) knows about this split.
  sourceTrackKey String?  @map("source_track_key")

  user  User   @relation("CertificateHolder", fields: [userId], references: [id])
  batch Batch? @relation(fields: [batchId], references: [id])

  @@index([regNo])
  @@map("certificates")
}

// ─────────────────────────────────────────────────────────────────
// LIVE CLASSES & ATTENDANCE
// ─────────────────────────────────────────────────────────────────

// CONFIRMED DEAD: store.js's empty() has no `live_classes` array and no
// `seq.live_classes` counter at all (checked directly) — nothing in this
// codebase ever creates a LiveClass row. All real "live class" functionality
// (built-in Jitsi room, start/join, attendance) lives entirely on `Session`
// (room, started_at, started_by, ended_at — see Session above). This model
// is kept only because migrations/0001_legacy_store_schema.sql and
// migrations/collections.js still declare a live_classes table; it will
// always be empty in practice. Fields below are the original unverified
// guess and are NOT independently confirmed (there is no writer to check
// them against).
model LiveClass {
  id        Int       @id @default(autoincrement())
  batchId   Int       @map("batch_id")
  title     String
  room      String
  startedBy Int       @map("started_by")
  startedAt DateTime  @map("started_at")
  endedAt   DateTime? @map("ended_at")
  date      String

  batch Batch @relation(fields: [batchId], references: [id])

  @@map("live_classes")
}

model Attendance {
  id        Int       @id @default(autoincrement())
  // Not always present: missing on 4/7 real rows, which carry class_id
  // instead (see classId below) - store.js's current writer
  // (Attendance.mark, store.js:1709-1723) always sets this, but older rows
  // don't have it.
  sessionId Int?      @map("session_id")
  // Re-added: absent from current app code (a prior schema draft's
  // `classId Int?` was dropped on that basis - see git history), but
  // genuinely present on 4/7 real rows, disjoint from the ones that have
  // sessionId. Likely this table's field name before a rename to
  // session_id. Kept separate from sessionId rather than merged/backfilled
  // - there's no confirmed proof they're interchangeable, and preserving
  // the real historical value as-is is safer than guessing.
  classId   Int?      @map("class_id")
  userId    Int       @map("user_id")
  joinedAt  DateTime  @map("joined_at")
  minutes   Int       @default(0)
  lastSeen  DateTime? @map("last_seen")

  session Session? @relation(fields: [sessionId], references: [id])
  user    User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("attendance")
}

// ─────────────────────────────────────────────────────────────────
// COMMUNICATION
// ─────────────────────────────────────────────────────────────────

model CourseMessage {
  id        Int      @id @default(autoincrement())
  batchId   Int      @map("batch_id")
  userId    Int      @map("user_id")
  body      String
  anonymous Boolean  @default(false)
  staffRole String?  @map("staff_role")
  createdAt DateTime @map("created_at")
  // Not always present: missing entirely on 3/6 real messages, which predate
  // the @mentions feature (audited against /data/echolens.json 2026-07-26).
  mentions  Json?

  batch Batch @relation(fields: [batchId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([batchId, createdAt])
  @@map("course_messages")
}

model ChatRead {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  batchId    Int      @map("batch_id")
  lastReadAt DateTime @map("last_read_at")

  user  User  @relation(fields: [userId], references: [id])
  batch Batch @relation(fields: [batchId], references: [id])

  @@unique([userId, batchId])
  @@map("chat_reads")
}

model Announcement {
  id        Int      @id @default(autoincrement())
  batchId   Int?     @map("batch_id") // null = platform-wide
  authorId  Int      @map("author_id")
  title     String
  body      String
  createdAt DateTime @map("created_at")

  batch Batch? @relation(fields: [batchId], references: [id])

  @@map("announcements")
}

model PublicAnnouncement {
  id        Int      @id @default(autoincrement())
  kind      String
  title     String
  body      String
  link      String?
  linkLabel String?  @map("link_label")
  pinned    Boolean  @default(false)
  createdBy Int      @map("created_by")
  createdAt DateTime @map("created_at")

  @@map("public_announcements")
}

// ─────────────────────────────────────────────────────────────────
// AI REPORTS
// ─────────────────────────────────────────────────────────────────

model AiReport {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  batchId     Int?      @map("batch_id")
  scope       String
  markdown    String
  status      String // draft|published|deleted
  createdAt   DateTime  @map("created_at")
  // MISSING from original draft: AiReports.publish() sets this (store.js:1164).
  publishedAt DateTime? @map("published_at")
  by          Int

  user  User   @relation("ReportSubject", fields: [userId], references: [id])
  batch Batch? @relation(fields: [batchId], references: [id])

  @@map("ai_reports")
}

// ─────────────────────────────────────────────────────────────────
// EVENTS (webinars / competitions)
// ─────────────────────────────────────────────────────────────────

model Event {
  id              Int       @id @default(autoincrement())
  kind            String
  title           String
  description     String
  scope           String
  entry           String
  feePkr          Int       @map("fee_pkr")
  payInstructions String?   @map("pay_instructions")
  // Raw pass-through from an <input type="datetime-local"> ("YYYY-MM-DDTHH:MM",
  // no seconds/offset) — NOT built via now(), no reformatting (store.js:2401,
  // 2428). Nullability confirmed correct; format differs from the now()
  // convention, so the import script must not assume seconds are present.
  startsAt        DateTime? @map("starts_at")
  endsAt          DateTime? @map("ends_at")
  // VERIFIED date-only, same regex convention as Quest.deadline (store.js:2404,2430).
  deadline        String?
  durationMinutes Int?      @map("duration_minutes")
  // VERIFIED never null: `Math.max(0,Math.min(100,Number(b.pass_mark)||0))` (store.js:2406,2432).
  passMark        Int       @default(0) @map("pass_mark")
  autoGrade       Boolean   @default(false) @map("auto_grade")
  autoCertificate Boolean   @default(false) @map("auto_certificate")
  compiler        String?
  datasetUrl      String?   @map("dataset_url")
  // VERIFIED always an array (possibly empty), never null (store.js:2411,2454-2461).
  files           Json      @default("[]")
  // VERIFIED always an array (possibly empty), never null (store.js:2381-2391).
  problems        Json      @default("[]")
  // VERIFIED always an object {first,second,third}, never null (store.js:2413).
